@page "/laboratorios"

<PageTitle>Laboratórios</PageTitle>

<h1>Laboratórios</h1>

<nav class="flex-column navigation-list">
	@foreach (var lab in labs)
	{
		<div class="nav-item px-3">
			<NavLink class="nav-link" href=@lab.Item2>
				@lab.Item1
			</NavLink>
		</div>
	}
</nav>

@code {
	Tuple<string, string>[] labs = new[]
	{
		Tuple.Create("Lab VICIA", "laboratorios/lab-vicia"),
		Tuple.Create("LaTIM", "laboratorios/latim")
	};
}
